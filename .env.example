# Supabase server-side verification
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Required to save user-owned provider keys encrypted in Supabase.
# Generate once with: openssl rand -base64 32
# Keep this value server-only, back it up, and do not rotate without re-encrypting stored keys.
KHARAIT_CREDENTIALS_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY
